---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import PagerNav from '@/components/ui/PagerNav.astro';
import ContactTrigger from '@/components/contact/ContactTrigger.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import type { AreaKey } from '@/lib/copy';
import type { Crumb, Pager } from '@/lib/nav';

interface Props {
  title: string;
  description: string;
  area?: AreaKey;
  crumbs?: Crumb[];
  pager?: Pager;
  ctaLabel?: string;
}
const { title, description, area, crumbs, pager, ctaLabel = 'Contattaci' } = Astro.props;
---

<BaseLayout title={title} description={description} area={area} crumbs={crumbs}>
  {
    crumbs && (
      <div class="border-b border-[var(--hairline)] px-6 py-5">
        <div class="mx-auto w-full max-w-[1200px]">
          <Breadcrumbs crumbs={crumbs} />
        </div>
      </div>
    )
  }

  <slot />

  <section class="border-t border-[var(--hairline)] px-6 py-[clamp(3rem,7vw,6rem)]">
    <div
      class="mx-auto flex w-full max-w-[1200px] flex-col items-start gap-6 md:flex-row md:items-center md:justify-between"
    >
      <SectionTitle size="md" class="max-w-[24ch]">Parliamo del tuo caso</SectionTitle>
      <ContactTrigger section={area} label={ctaLabel} />
    </div>
  </section>

  {pager && <PagerNav pager={pager} />}
</BaseLayout>
