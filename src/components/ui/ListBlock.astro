---
import Card from './Card.astro';
import type { Block } from '@/lib/copy';

interface Props {
  block: Block;
  class?: string;
}
const { block, class: className = '' } = Astro.props;

const isWarning = block.variant === 'warning';
const warnStyle = isWarning
  ? 'border-l-[3px] border-l-[var(--accent-strong)]'
  : '';
---

<Card class={`${warnStyle} ${className}`}>
  <h3 class="section-title text-base md:text-lg">{block.title}</h3>
  {block.intro && <p class="mt-3 text-sm text-[var(--text-muted)]">{block.intro}</p>}
  {block.text && <p class="mt-3 text-[var(--text-soft)]">{block.text}</p>}
  {
    block.items && block.items.length > 0 && (
      <ul class="list-marker mt-4 flex flex-col gap-2 text-[var(--text-soft)]">
        {block.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</Card>
