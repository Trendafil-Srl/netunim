---
import Card from './Card.astro';

interface Props {
  n: string;
  title: string;
  subtitle?: string;
  class?: string;
}
const { n, title, subtitle, class: className = '' } = Astro.props;
---

<Card class={className}>
  <p class="num-index text-3xl md:text-4xl">{n}</p>
  <h3 class="section-title mt-4 text-base md:text-lg">{title}</h3>
  {subtitle && <p class="mt-2 text-sm text-[var(--text-muted)]">{subtitle}</p>}
  <slot />
</Card>
