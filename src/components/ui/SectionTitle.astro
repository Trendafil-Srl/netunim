---
interface Props {
  /** Livello semantico: usa h1 una sola volta per pagina. */
  as?: 'h1' | 'h2' | 'h3';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  id?: string;
  class?: string;
}
const { as: Tag = 'h2', size = 'md', id, class: className = '' } = Astro.props as Props;

const sizes = {
  sm: 'text-lg md:text-xl',
  md: 'text-2xl md:text-3xl',
  lg: 'text-3xl md:text-4xl lg:text-5xl',
  xl: 'text-4xl md:text-5xl lg:text-6xl',
};
---

<Tag id={id} class={`section-title ${sizes[size]} ${className}`}><slot /></Tag>
