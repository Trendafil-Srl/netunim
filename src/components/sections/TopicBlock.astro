---
/**
 * Renderizza un topic scegliendo il layout in base alle chiavi presenti nel JSON.
 * Un solo componente intelligente: aggiungere un topic al JSON non richiede
 * una nuova pagina né un nuovo componente.
 */
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Card from '@/components/ui/Card.astro';
import ListBlock from '@/components/ui/ListBlock.astro';
import NumberedCard from '@/components/ui/NumberedCard.astro';
import Callout from '@/components/ui/Callout.astro';
import StatementBlock from '@/components/ui/StatementBlock.astro';
import { normalizeClosing, type Topic } from '@/lib/copy';

interface Props {
  topic: Topic;
  /** h1 solo sul primo topic di una pagina di contenuto. */
  headingLevel?: 'h1' | 'h2';
}
const { topic, headingLevel = 'h2' } = Astro.props;

const closing = normalizeClosing(topic.closing);
const titleId = `topic-${topic.id}`;
---

{
  topic.variant === 'statement' ? (
    <StatementBlock
      statement={{
        eyebrow: topic.eyebrow,
        title: topic.title,
        lead: topic.lead,
      }}
    />
  ) : (
    <Section id={topic.id} labelledby={titleId}>
      <header class="reveal">
        {topic.eyebrow && <Eyebrow text={topic.eyebrow} class="mb-6" />}
        <SectionTitle as={headingLevel} size="lg" id={titleId}>
          {topic.title}
        </SectionTitle>
        {topic.lead && <p class="prose-body mt-6 text-lg">{topic.lead}</p>}
      </header>

      {/* --- blocks: griglia di ListBlock --- */}
      {topic.blocks && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {topic.blocks.map((block) => (
            <ListBlock block={block} />
          ))}
        </div>
      )}

      {/* --- steps / fasi: timeline numerata --- */}
      {(topic.steps ?? topic.fasi) && (
        <ol class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {(topic.steps ?? topic.fasi)!.map((step) => (
            <li class="h-full">
              <NumberedCard n={step.n.padStart(2, '0')} title={step.title}>
                {step.text && <p class="mt-3 text-sm text-[var(--text-soft)]">{step.text}</p>}
                {step.items && (
                  <ul class="list-marker mt-4 flex flex-col gap-2 text-sm text-[var(--text-soft)]">
                    {step.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </NumberedCard>
            </li>
          ))}
        </ol>
      )}

      {/* --- checklist: elenco verificabile a due colonne --- */}
      {topic.checklist && (
        <ul class="reveal mt-12 grid gap-x-8 gap-y-px md:grid-cols-2">
          {topic.checklist.map((item) => (
            <li class="flex items-baseline gap-4 border-b border-[var(--hairline)] py-4">
              <span class="num-index text-sm">{item.n}</span>
              <span class="text-[var(--text-soft)]">{item.text}</span>
            </li>
          ))}
        </ul>
      )}

      {/* --- livelli: quattro tier di report --- */}
      {topic.livelli && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {topic.livelli.map((tier) => (
            <NumberedCard n={tier.n} title={tier.title} subtitle={tier.subtitle}>
              <ul class="list-marker mt-4 flex flex-col gap-2 text-sm text-[var(--text-soft)]">
                {tier.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </NumberedCard>
          ))}
        </div>
      )}

      {/* --- ambiti / servizi / benefici: coppie titolo + testo --- */}
      {(topic.ambiti ?? topic.servizi ?? topic.benefici) && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {(topic.ambiti ?? topic.servizi ?? topic.benefici)!.map((item) => (
            <Card title={item.title}>
              <p class="text-sm text-[var(--text-soft)]">{item.text}</p>
            </Card>
          ))}
        </div>
      )}

      {/* --- ragioni / blocchi: numerati con testo --- */}
      {(topic.ragioni ?? topic.blocchi) && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {(topic.ragioni ?? topic.blocchi)!.map((item) => (
            <NumberedCard n={item.n.padStart(2, '0')} title={item.title}>
              <p class="mt-3 text-sm text-[var(--text-soft)]">{item.text}</p>
            </NumberedCard>
          ))}
        </div>
      )}

      {/* --- gruppi: famiglie di clienti --- */}
      {topic.gruppi && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {topic.gruppi.map((gruppo) => (
            <NumberedCard n={gruppo.n.padStart(2, '0')} title={gruppo.title}>
              <ul class="list-marker mt-4 flex flex-col gap-2 text-sm text-[var(--text-soft)]">
                {gruppo.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </NumberedCard>
          ))}
        </div>
      )}

      {/* --- licenze: le due autorizzazioni ex art. 134 TULPS --- */}
      {topic.licenze && (
        <div class="reveal mt-12 grid gap-5 md:grid-cols-2">
          {topic.licenze.map((licenza) => (
            <Card>
              <h3 class="section-title text-lg text-[var(--accent-text)]">{licenza.title}</h3>
              <p class="mt-3 text-sm text-[var(--text-soft)]">{licenza.holder}</p>
              {licenza.body && <p class="mt-4 text-sm text-[var(--text-soft)]">{licenza.body}</p>}
              {licenza.items && (
                <ul class="list-marker mt-4 flex flex-col gap-2 text-sm text-[var(--text-soft)]">
                  {licenza.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              <p class="mt-5 border-t border-[var(--hairline)] pt-4 text-sm text-[var(--text-muted)]">
                {licenza.detail}
              </p>
            </Card>
          ))}
        </div>
      )}

      {/* --- principi operativi, con icona --- */}
      {topic.principi && (
        <>
          {topic.principiTitle && (
            <h3 class="section-title reveal mt-16 text-xl">{topic.principiTitle}</h3>
          )}
          <ul class="reveal mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {topic.principi.map((principio) => (
              <li class="h-full">
                <Card class="flex h-full flex-col">
                  <div class="flex items-start justify-between gap-4">
                    <span
                      class="block h-10 w-10 shrink-0 text-[var(--accent-text)]"
                      style={`-webkit-mask:url(/brand/icons/${principio.icon}.svg) no-repeat center/contain;mask:url(/brand/icons/${principio.icon}.svg) no-repeat center/contain;background-color:currentColor`}
                      aria-hidden="true"
                    />
                    <span class="num-index text-2xl">{principio.n}</span>
                  </div>
                  <h4 class="section-title mt-5 text-base">{principio.title}</h4>
                  <p class="mt-2 text-sm text-[var(--accent-text)]">{principio.short}</p>
                  <p class="mt-3 text-sm text-[var(--text-soft)]">{principio.text}</p>
                </Card>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* --- vision --- */}
      {topic.visionItems && (
        <div class="reveal mt-12 border border-[var(--hairline)] bg-[var(--surface)] p-6 md:p-10">
          {topic.visionTitle && <p class="eyebrow">{topic.visionTitle}</p>}
          {topic.visionLead && (
            <p class="mt-4 max-w-[60ch] text-lg text-[var(--text-soft)]">{topic.visionLead}</p>
          )}
          <ul class="mt-6 flex flex-wrap gap-2">
            {topic.visionItems.map((item) => (
              <li class="border border-[var(--hairline)] px-3 py-1.5 text-sm text-[var(--text-soft)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* --- note: livello avanzato, blocco AI --- */}
      {topic.advanced && (
        <Callout title={topic.advanced.title} class="reveal mt-10">
          {topic.advanced.text}
        </Callout>
      )}
      {topic.aiBlock && (
        <Callout title={topic.aiBlock.title} class="reveal mt-10">
          {topic.aiBlock.text}
        </Callout>
      )}

      {/* --- disclaimer legali: sempre visibili, mai in accordion --- */}
      {topic.disclaimers && (
        <div class="reveal mt-10 grid gap-4 md:grid-cols-2">
          {topic.disclaimers.map((d) => (
            <Callout title={d.title} variant="warning">
              {d.text}
            </Callout>
          ))}
        </div>
      )}
      {topic.warning && (
        <Callout title={topic.warning.title ?? 'Avvertenza'} variant="warning" class="reveal mt-10">
          {topic.warning.text}
        </Callout>
      )}
      {topic.disclaimer && (
        <p class="reveal mt-8 border-l-[3px] border-l-[var(--accent-strong)] bg-[var(--surface)] p-5 text-sm italic">
          {topic.disclaimer}
        </p>
      )}

      {/* --- closing --- */}
      {closing && (
        <p class="reveal mt-12 max-w-[80ch] text-xl text-[var(--accent-text)] md:text-2xl">
          {closing.title && (
            <span class="mb-2 block text-[11px] tracking-[0.18em] text-[var(--text-muted)] uppercase">
              {closing.title}
            </span>
          )}
          {closing.text}
        </p>
      )}
    </Section>
  )
}

{/* Uno statement annidato chiude il topic a tutta larghezza. */}
{topic.variant !== 'statement' && topic.statement && (
  <StatementBlock statement={topic.statement} />
)}
