# ---------- Destinatari (DA CONFERMARE CON IL CLIENTE) ----------
# Accettano più indirizzi separati da virgola.
CONTACT_EMAIL_COMMERCIALE=commerciale@netunim.com
CONTACT_EMAIL_INVESTIGAZIONE=investigazioni@netunim.com

# ---------- Trasporto mail: smtp | graph ----------
MAIL_TRANSPORT=smtp

# ---------- SMTP Microsoft 365 (valido fino a dicembre 2026) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@netunim.com
SMTP_PASSWORD=                      # app password, NON la password dell'utente
SMTP_FROM=noreply@netunim.com
SMTP_FROM_NAME=NETUNIM · Sito web

# ---------- Microsoft Graph (percorso di migrazione) ----------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=noreply@netunim.com

# ---------- Varie ----------
SITE_URL=https://netunim.com        # origin consentita in CORS
CONFIRMATION_ENABLED=true
IP_HASH_SALT=                       # stringa random 32+ char: openssl rand -hex 24
