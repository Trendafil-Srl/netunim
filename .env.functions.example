# ---------- Destinatari (DA CONFERMARE CON IL CLIENTE) ----------
# Accettano più indirizzi separati da virgola.
NETUNIM_EMAIL_COMMERCIALE=commerciale@netunim.com
NETUNIM_EMAIL_INVESTIGAZIONE=investigazioni@netunim.com

# ---------- Trasporto mail: smtp | graph ----------
NETUNIM_MAIL_TRANSPORT=smtp

# ---------- SMTP Microsoft 365 (valido fino a dicembre 2026) ----------
NETUNIM_SMTP_HOST=smtp.office365.com
NETUNIM_SMTP_PORT=587
NETUNIM_SMTP_USER=noreply@netunim.com
NETUNIM_SMTP_PASSWORD=                      # app password, NON la password dell'utente
NETUNIM_SMTP_FROM=noreply@netunim.com
NETUNIM_SMTP_FROM_NAME=NETUNIM · Sito web

# ---------- Microsoft Graph (percorso di migrazione) ----------
NETUNIM_GRAPH_TENANT_ID=
NETUNIM_GRAPH_CLIENT_ID=
NETUNIM_GRAPH_CLIENT_SECRET=
NETUNIM_GRAPH_SENDER_UPN=noreply@netunim.com

# ---------- Varie ----------
SITE_URL=https://netunim.com        # origin consentita in CORS
NETUNIM_CONFIRMATION_ENABLED=true
NETUNIM_IP_HASH_SALT=                       # stringa random 32+ char: openssl rand -hex 24
